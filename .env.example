# Variables d'environnement de Nomen Nature.
# Copier ce fichier en `.dev.vars` pour le développement local (ignoré par git).
# En ligne, ces valeurs sont des secrets Cloudflare : `npx wrangler secret put NOM`.
# Ne jamais mettre de vraie valeur dans ce fichier.

# Clé de l'API Pl@ntNet (lot 9), utilisée uniquement côté serveur.
PLANTNET_API_KEY=

# Adresse Sentry pour le suivi des erreurs (lot 2, QUE-17).
SENTRY_DSN=
