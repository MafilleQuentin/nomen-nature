{
  "name": "nomen-nature",
  "version": "0.6.0",
  "private": true,
  "description": "Nomen Nature : explorer la biodiversité mondiale, gratuit et non commercial",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "astro check && vitest run && playwright test",
    "deploy:test": "astro build --mode essai && wrangler deploy",
    "donnees:import": "node --max-old-space-size=6144 tools/donnees/import.ts",
    "donnees:installer": "node tools/donnees/installer.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@astrojs/svelte": "9.1.2",
    "@sentry/cloudflare": "11.10.0",
    "astro": "7.4.7",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true,
    "workerd@1.20261103.1": true
  }
}
