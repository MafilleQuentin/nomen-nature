---
// Page d'un continent en français (/fr/continent/europe?pays=ch&onglet=menacees), rendue à la
// demande par le Worker : le panneau lit les listes du mois (lot 6, QUE-30). Gardée un jour chez
// Cloudflare (src/middleware.ts), une entrée par pays et par onglet ; 5 minutes dans le navigateur.
import { EN_TETE_CACHE } from "../../../lib/cache";
import { continentDeLAdresse } from "../../../lib/carte/continents";
import { lireCourbes } from "../../../lib/carte/courbes";
import { chargerPanneau, lienDuPays, paysDesListes } from "../../../lib/carte/serveur";
import Continent from "../../../vues/Continent.astro";

export const prerender = false;

const continent = continentDeLAdresse(Astro.params.adresse ?? "", "fr");
// Continent inconnu : la page introuvable du site (sans importer sa vue ici, dont le fond de
// courbes de niveau, 37 Ko, serait sinon chargé sur toutes les pages des continents).
if (!continent) return Astro.rewrite("/404");
// Ancienne adresse du panneau d'un pays (?pays=ch, lot 6) : la page du pays (lot 7).
const ancienPays = Astro.url.searchParams.get("pays")?.toLowerCase();
if (ancienPays && (await paysDesListes(Astro.url))?.includes(ancienPays)) return Astro.redirect(lienDuPays(ancienPays, "fr"), 301);
const [panneau, courbes] = await Promise.all([chargerPanneau(Astro.url, "fr", continent.code), lireCourbes(Astro.url)]);
Astro.response.headers.set("Cache-Control", "public, max-age=300");
if (panneau) Astro.response.headers.set(EN_TETE_CACHE, "1");
---

<Continent langue="fr" code={continent.code} panneau={panneau} courbes={courbes?.continents[continent.code]} />
