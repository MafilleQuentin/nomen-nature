---
// Page d'un continent en français (/fr/continent/europe), construite d'avance : la carte ne
// dépend que des frontières de Natural Earth (lot 6, QUE-29).
import { CODES_CONTINENTS, CONTINENTS } from "../../../lib/carte/continents";
import Continent from "../../../vues/Continent.astro";

export function getStaticPaths() {
  return CODES_CONTINENTS.map((code) => ({ params: { adresse: CONTINENTS[code].adresse.fr }, props: { code } }));
}

const { code } = Astro.props;
---

<Continent langue="fr" code={code} />
