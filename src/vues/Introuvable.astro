---
// Page introuvable (Figma « Page introuvable (404) », 96:643 ordinateur et 96:694 téléphone).
// Un seul appel à l'action principal : « Retour à la carte ». Sur téléphone, la maquette
// garde une phrase plus courte et retire « Autour de moi ».
import BarreDeRecherche from "../components/BarreDeRecherche.astro";
import Bouton from "../components/Bouton.astro";
import type { Langue } from "../i18n/langues";
import { t } from "../i18n/textes";
import Base from "../layouts/Base.astro";
import { lien } from "../lib/liens";

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue).introuvable;
---

<Base titre={textes.titrePage} description={textes.descriptionPage} langue={langue} indexer={false}>
  <div class="introuvable">
    <p class="t-mono-surtitre surtitre">{textes.surtitre}</p>
    <p class="code" aria-hidden="true">404</p>
    <h1 class="titre">{textes.titre}</h1>
    <p class="texte">
      {textes.texte}<span class="ordi"> {textes.texteSuite}</span>
    </p>
    <BarreDeRecherche langue={langue} taille="grand" class="ordi-flex" id="recherche-ordinateur" />
    <BarreDeRecherche langue={langue} taille="compact" class="tel-flex" id="recherche-telephone" />
    <div class="actions">
      <Bouton href={lien("carte", langue)} icone="globe" class="action-principale">{textes.retourCarte}</Bouton>
      <Bouton href={lien("autourDeMoi", langue)} variante="secondaire" icone="position" class="ordi-flex">
        {textes.autourDeMoi}
      </Bouton>
    </div>
  </div>
</Base>

<style>
  /* Fond de courbes de niveau sur toute la page, en-tête et pied de page compris (maquette). */
  /* Ces styles ne sont chargés que sur cette page. Motif téléphone sous 600 px (étiré au plus
     de 1,5 fois), motif ordinateur au-delà. */
  :global(body) {
    background:
      url("../assets/motifs/courbes-telephone.svg") top left / max(100%, 390px) auto no-repeat,
      var(--color-bg-page);
  }
  @media (min-width: 600px) {
    :global(body) {
      background:
        url("../assets/motifs/courbes-ordinateur.svg") top left / max(100%, 1440px) auto no-repeat,
        var(--color-bg-page);
    }
  }

  .introuvable {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-14) var(--space-5);
    text-align: center;
  }
  .introuvable p,
  .titre {
    margin: 0;
  }
  .surtitre {
    display: none;
    color: var(--color-text-highlight);
  }
  .code {
    font: 700 96px / 1.05 var(--font-titre);
    letter-spacing: -0.02em;
    color: var(--color-text-accent);
  }
  .titre {
    font: 700 22px / 1.25 var(--font-titre);
    letter-spacing: -0.01em;
  }
  .texte {
    font: 400 16px / 1.5 var(--font-texte);
    color: var(--color-text-secondary);
  }
  .actions {
    display: flex;
    gap: var(--space-3);
    width: 100%;
  }
  .actions :global(.action-principale) {
    flex: 1;
  }
  .ordi,
  .introuvable :global(.ordi-flex) {
    display: none;
  }

  @media (min-width: 900px) {
    .introuvable {
      gap: var(--space-5);
      padding: var(--space-20);
    }
    .surtitre {
      display: block;
    }
    .code {
      font-size: 160px;
    }
    .titre {
      font-size: 34px;
      line-height: 1.2;
    }
    .texte {
      max-width: 620px;
      font-size: 19px;
    }
    .ordi {
      display: inline;
    }
    .introuvable :global(.ordi-flex) {
      display: flex;
    }
    .introuvable :global(.tel-flex) {
      display: none;
    }
    .actions {
      width: auto;
    }
    .actions :global(.action-principale) {
      flex: none;
    }
  }
</style>
