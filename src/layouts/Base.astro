---
// Gabarit de base de toutes les pages : langue, métadonnées, polices et styles communs.
// L'en-tête, le pied de page et le menu viendront avec QUE-13.
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  titre: string;
  description: string;
  langue?: "fr" | "en";
  indexer?: boolean;
}

const { titre, description, langue = "fr", indexer = true } = Astro.props;
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {!indexer && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0f2a21" />
    <!-- Préchargement : seulement les polices visibles dès l'arrivée (titres et texte courant). -->
    <Font cssVariable="--font-titre" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-texte" preload={[{ subset: "latin", weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
