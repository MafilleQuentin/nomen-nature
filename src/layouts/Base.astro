---
// Gabarit de base de toutes les pages : langue, métadonnées, polices, styles communs,
// lien d'évitement, en-tête, contenu principal et pied de page.
import { Font } from "astro:assets";
import EnTete from "../components/EnTete.astro";
import PiedDePage from "../components/PiedDePage.astro";
import { langues, type Langue } from "../i18n/langues";
import { t } from "../i18n/textes";
import { lien, traductions, type Page } from "../lib/liens";
import "../styles/global.css";

interface Props {
  titre: string;
  description: string;
  langue: Langue;
  /** Clé de la page dans la table des adresses : donne ses versions dans les autres langues. */
  page?: Page;
  indexer?: boolean;
}

const { titre, description, langue, page, indexer = true } = Astro.props;
const textes = t(langue);

// Versions de la page dans chaque langue. Une page sans clé (page de contrôle) renvoie
// vers l'accueil de l'autre langue et n'annonce pas de version traduite.
const versions = page ? traductions(page) : traductions("accueil");
const absolue = (chemin: string) => new URL(chemin, Astro.site).href;
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {/* Le site de test (construit avec --mode essai) n'est jamais indexé. */}
    {(!indexer || import.meta.env.MODE === "essai") && <meta name="robots" content="noindex" />}
    {page && indexer && <link rel="canonical" href={absolue(lien(page, langue))} />}
    {page && langues.map((l) => <link rel="alternate" hreflang={l} href={absolue(versions[l])} />)}
    <!-- x-default : la racine, qui envoie vers la langue du navigateur. -->
    {page && <link rel="alternate" hreflang="x-default" href={absolue("/")} />}
    <meta name="theme-color" content="#0f2a21" />
    <!-- Préchargement : seulement les polices visibles dès l'arrivée (titres et texte courant). -->
    <Font cssVariable="--font-titre" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-texte" preload={[{ subset: "latin", weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="evitement t-libelle-normal" href="#contenu">{textes.general.allerAuContenu}</a>
    <EnTete langue={langue} versions={versions} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage langue={langue} versions={versions} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
  /* Lien d'évitement : invisible jusqu'à ce qu'on y arrive au clavier. */
  .evitement {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg-accent);
    color: var(--color-text-on-accent);
    transform: translateY(-200%);
  }
  .evitement:focus {
    transform: none;
  }
</style>
