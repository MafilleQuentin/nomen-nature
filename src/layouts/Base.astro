---
// Gabarit de base de toutes les pages : langue, métadonnées, polices, styles communs,
// lien d'évitement, en-tête, contenu principal et pied de page.
import { Font } from "astro:assets";
import EnTete from "../components/EnTete.astro";
import PiedDePage from "../components/PiedDePage.astro";
import "../styles/global.css";

interface Props {
  titre: string;
  description: string;
  langue?: "fr" | "en";
  indexer?: boolean;
}

const { titre, description, langue = "fr", indexer = true } = Astro.props;
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {!indexer && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0f2a21" />
    <!-- Préchargement : seulement les polices visibles dès l'arrivée (titres et texte courant). -->
    <Font cssVariable="--font-titre" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-texte" preload={[{ subset: "latin", weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="evitement t-libelle-normal" href="#contenu">Aller au contenu</a>
    <EnTete />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
  /* Lien d'évitement : invisible jusqu'à ce qu'on y arrive au clavier. */
  .evitement {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-bg-accent);
    color: var(--color-text-on-accent);
    transform: translateY(-200%);
  }
  .evitement:focus {
    transform: none;
  }
</style>
