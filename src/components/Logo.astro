---
// Logo provisoire (Figma « Logo », 75:2) : feuille menthe + mot-symbole « Nomen ».
// À remplacer par le logo définitif (QUE-41).
import feuille from "../assets/icones/logo-feuille.svg?url";
import type { Langue } from "../i18n/langues";
import { t } from "../i18n/textes";
import { lien } from "../lib/liens";

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
---

<a class="logo" href={lien("accueil", langue)} aria-label={t(langue).general.logo}>
  <img src={feuille} alt="" width="30" height="30" />
  <span class="t-logo">Nomen</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    text-decoration: none;
  }
</style>
