---
// En-tête (Figma « En-tête », 76:60) et menu sur téléphone (« Menu · Téléphone », 95:427).
// Ordinateur : logo, navigation, langue. Téléphone : logo, langue, bouton menu qui ouvre
// un panneau plein écran (<dialog> natif : focus piégé, touche Échap, retour du focus).
import courbes from "../assets/motifs/courbes-menu.svg?url";
import { liens } from "../lib/liens";
import Icone, { type NomIcone } from "./Icone.astro";
import Logo from "./Logo.astro";

const navigation = [
  { libelle: "Explorer", href: liens.carte },
  { libelle: "Identifier", href: liens.identifier },
  { libelle: "Espèces menacées", href: liens.menacees },
  { libelle: "À propos", href: liens.aPropos },
];

const menu: { libelle: string; href: string; icone: NomIcone }[] = [
  { libelle: "Explorer la carte", href: liens.carte, icone: "globe" },
  { libelle: "Autour de moi", href: liens.autourDeMoi, icone: "position" },
  { libelle: "Identifier une plante", href: liens.identifier, icone: "appareil-photo" },
  { libelle: "Espèces menacées", href: liens.menacees, icone: "feuille" },
  { libelle: "Rechercher", href: liens.recherche, icone: "recherche" },
];

const annexes = [
  { libelle: "À propos", href: liens.aPropos },
  { libelle: "Sources et crédits", href: liens.sources },
  { libelle: "Confidentialité", href: liens.confidentialite },
  { libelle: "Mentions légales", href: liens.mentionsLegales },
];

// La version anglaise arrive avec QUE-14.
const versionAnglaise = "/en/";
---

<header class="en-tete">
  <Logo />

  <nav class="navigation" aria-label="Navigation principale">
    <ul class="t-mono-navigation">
      {navigation.map(({ libelle, href }) => <li><a href={href}>{libelle}</a></li>)}
    </ul>
  </nav>

  <div class="actions">
    <a class="langue" href={versionAnglaise} hreflang="en" lang="en" aria-label="English version">
      <Icone nom="globe" taille={18} class="langue__icone-ordi" />
      <Icone nom="globe" taille={22} class="langue__icone-tel" />
      <span class="t-libelle-petit langue__code" aria-hidden="true">FR</span>
    </a>
    <button class="bouton-menu" type="button" aria-label="Ouvrir le menu" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-ouvrir-menu>
      <Icone nom="menu" taille={24} />
    </button>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menu" style={`--courbes: url("${courbes}")`}>
  <div class="menu__haut">
    <Logo />
    <button class="bouton-fermer" type="button" aria-label="Fermer le menu" data-fermer-menu>
      <Icone nom="fermer" taille={26} />
    </button>
  </div>

  <nav class="menu__navigation" aria-label="Menu">
    <ul>
      {menu.map(({ libelle, href, icone }) => (
        <li>
          <a href={href}>
            <Icone nom={icone} taille={24} class="menu__icone" />
            <span class="t-titre-section-compact">{libelle}</span>
            <Icone nom="fleche-droite" taille={20} class="menu__icone" />
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="menu__bas">
    <div class="menu__langue" role="group" aria-labelledby="menu-langue">
      <span id="menu-langue" class="t-mono-surtitre secondaire">Langue</span>
      <a class="puce puce--selectionnee t-libelle-petit" href="/" aria-current="true" lang="fr">Français</a>
      <a class="puce t-libelle-petit" href={versionAnglaise} hreflang="en" lang="en">English</a>
    </div>
    <ul class="menu__annexes t-mono-legende">
      {annexes.map(({ libelle, href }) => <li><a href={href}>{libelle}</a></li>)}
    </ul>
  </div>
</dialog>

<script>
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  const ouvrir = document.querySelector<HTMLButtonElement>("[data-ouvrir-menu]");
  const fermer = menu?.querySelector<HTMLButtonElement>("[data-fermer-menu]");

  ouvrir?.addEventListener("click", () => {
    menu?.showModal();
    ouvrir.setAttribute("aria-expanded", "true");
  });
  fermer?.addEventListener("click", () => menu?.close());
  menu?.addEventListener("close", () => {
    ouvrir?.setAttribute("aria-expanded", "false");
    ouvrir?.focus();
  });
  // Si l'écran s'élargit (rotation, fenêtre), le menu téléphone n'a plus lieu d'être.
  window.matchMedia("(min-width: 900px)").addEventListener("change", (e) => {
    if (e.matches && menu?.open) menu.close();
  });
</script>

<style>
  /* --- En-tête --- */
  .en-tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .navigation {
    display: none;
  }
  .navigation ul {
    display: flex;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .navigation a,
  .langue {
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .navigation a:hover,
  .langue:hover {
    color: var(--color-text-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .langue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* Zones tactiles de 44 px sur téléphone, sans changer la taille des icônes. */
  .langue,
  .bouton-menu,
  .bouton-fermer {
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    margin: -10px;
  }
  .bouton-menu,
  .bouton-fermer {
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-icon-primary);
    cursor: pointer;
  }
  .langue__code,
  .langue :global(.langue__icone-ordi) {
    display: none;
  }

  @media (min-width: 900px) {
    .en-tete {
      padding: var(--space-5) var(--space-20);
    }
    .navigation {
      display: block;
    }
    .bouton-menu,
    .langue :global(.langue__icone-tel) {
      display: none;
    }
    .langue {
      margin: 0;
      min-width: 0;
      min-height: 0;
    }
    .langue__code,
    .langue :global(.langue__icone-ordi) {
      display: inline-block;
    }
  }

  /* --- Menu sur téléphone --- */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-text-primary);
    background: var(--courbes) top left / 390px auto no-repeat, var(--color-bg-page);
  }
  .menu::backdrop {
    background: var(--color-bg-page);
  }
  .menu__haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .menu__navigation {
    padding: var(--space-4) var(--space-5);
  }
  .menu__navigation ul,
  .menu__annexes {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__navigation a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .menu__navigation a span {
    flex: 1;
  }
  .menu__navigation :global(.menu__icone) {
    color: var(--color-icon-highlight);
  }
  .menu__bas {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
  }
  .menu__langue {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .secondaire {
    color: var(--color-text-secondary);
  }
  .puce {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .puce--selectionnee {
    background: var(--color-bg-inverse);
    border-color: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
  }
  .menu__annexes {
    display: flex;
    flex-wrap: wrap;
  }
  .menu__annexes li + li::before {
    content: "·";
    margin: 0 0.6ch;
    color: var(--color-text-secondary);
  }
  .menu__annexes a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
</style>
