---
// Carte d'un continent (lot 6, QUE-29 ; Figma « Continent — Europe », 81:3) : ses pays en clair,
// les pays voisins en sombre, frontières Natural Earth 1:50 m (tools/carte/pays.ts →
// src/data/carte/continents/<code>.json), noms des principaux pays en capitales sans
// chevauchement. Les pays deviendront des liens avec le panneau des espèces (QUE-30).
import type { Langue } from "../i18n/langues";
import { t } from "../i18n/textes";
import type { CodeContinent } from "../lib/carte/continents";
import { choisirEtiquettes } from "../lib/carte/etiquettes";
import { remplir } from "../lib/especes/affichage";
import CarteInteractive from "./CarteInteractive.astro";

interface Props {
  langue: Langue;
  code: CodeContinent;
}

interface PaysCarte {
  code: string;
  membre: boolean;
  chemin: string;
  etiquette: [number, number];
  rang: number;
}

const cartes = import.meta.glob<{ default: { vue: [number, number, number, number]; pays: PaysCarte[] } }>("../data/carte/continents/*.json", { eager: true });

const { langue, code } = Astro.props;
const carte = cartes[`../data/carte/continents/${code.toLowerCase()}.json`]?.default;
if (!carte) throw new Error(`Carte du continent ${code} absente (node tools/carte/pays.ts)`);
const textes = t(langue);
const nomDuPays = new Intl.DisplayNames([langue], { type: "region" });

// Étiquettes : taille de la maquette (11 px) pour une carte de 625 px de large.
const TAILLE = 11;
const taillePlan = (TAILLE * carte.vue[2]) / 625;
// Toutes les étiquettes possibles (par rang) ; celles qui tiennent sans se chevaucher sur une
// carte de 625 px sont marquées data-defaut et seules visibles sans JavaScript. Avec JavaScript,
// le script de CarteInteractive refait ce choix selon la largeur réelle et le zoom.
const candidates = carte.pays
  .filter((p) => p.membre && p.code)
  .map((p) => ({ code: p.code, nom: (nomDuPays.of(p.code) ?? p.code).toLocaleUpperCase(langue), point: p.etiquette, rang: p.rang }))
  .sort((a, b) => a.rang - b.rang || a.nom.localeCompare(b.nom))
  .slice(0, 40);
const parDefaut = new Set(choisirEtiquettes(candidates, carte.vue, taillePlan).map((e) => e.code));
---

<CarteInteractive
  langue={langue}
  vue={carte.vue}
  libelle={remplir(textes.carte.carteContinent, { nom: textes.continents[code] })}
  aide={textes.carte.aideContinent}
  role="img"
  etiquettesLibres
>
  {carte.pays.filter((p) => !p.membre).map((p) => <path class="voisin" d={p.chemin} transform="scale(0.1)" />)}
  {carte.pays.filter((p) => p.membre).map((p) => <path class="pays" d={p.chemin} transform="scale(0.1)" data-pays={p.code} />)}
  {
    candidates.map((e) => (
      <text class="etiquette" x={e.point[0]} y={e.point[1]} data-taille={TAILLE} data-defaut={parDefaut.has(e.code) ? "" : undefined} font-size={taillePlan}>
        {e.nom}
      </text>
    ))
  }
</CarteInteractive>

<style>
  path {
    stroke-linejoin: round;
    fill-rule: evenodd;
  }
  .voisin {
    fill: var(--color-map-neighbor);
    stroke: var(--color-map-background-line);
    stroke-width: 0.8;
  }
  .pays {
    fill: var(--color-bg-land);
    stroke: var(--color-map-coast);
    stroke-width: 0.6;
    stroke-opacity: 0.7;
  }
  .etiquette:not([data-defaut]) {
    display: none;
  }
  .etiquette {
    fill: var(--color-text-primary);
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
  }
</style>
