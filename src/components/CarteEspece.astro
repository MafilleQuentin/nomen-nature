---
// Carte espèce (Figma « Carte espèce », 76:18) : photo (ou courbes de niveau tant qu'elle
// manque), badge de statut UICN, nom courant, nom latin et groupe. Toute la carte est un lien
// vers la fiche. La photo et son crédit arrivent avec QUE-24.
import courbes from "../assets/motifs/courbes-carte.svg?url";
import type { Langue } from "../i18n/langues";
import { t } from "../i18n/textes";
import { nomAffiche } from "../lib/especes/affichage";
import type { CarteEspece } from "../lib/especes/fiche";
import { lienEspece } from "../lib/liens";
import BadgeStatut from "./BadgeStatut.astro";

interface Props {
  espece: CarteEspece;
  langue: Langue;
}

const { espece, langue } = Astro.props;
const nom = nomAffiche(espece, langue);
const groupes = t(langue).groupes as Record<string, string>;
const groupe = groupes[espece.groupe] ?? "";
---

<a class="carte" href={lienEspece(espece.adresse, langue)}>
  <div class="photo">
    <img class="courbes" src={courbes} alt="" width="302" height="187" loading="lazy" decoding="async" />
    <BadgeStatut uicn={espece.uicn} langue={langue} class="carte__badge" />
  </div>
  <div class="texte">
    <p class="t-titre-carte nom">{nom}</p>
    {nom !== espece.nom && <p class="t-texte-latin latin" lang="la">{espece.nom}</p>}
    {groupe && <p class="t-mono-legende groupe">{groupe}</p>}
  </div>
</a>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .carte:hover {
    border-color: var(--color-border-strong);
  }
  .photo {
    position: relative;
    height: 187px;
    overflow: hidden;
    background: var(--color-bg-surface-raised);
  }
  .courbes {
    position: absolute;
    inset: 0.53% -0.99% -0.53% 0.99%;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .photo :global(.carte__badge) {
    position: absolute;
    bottom: 10px;
    left: 10px;
  }
  .texte {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .texte p {
    margin: 0;
  }
  .latin,
  .groupe {
    color: var(--color-text-secondary);
  }
</style>
