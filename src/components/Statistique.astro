---
// Statistique (Figma « Statistique », 79:46) : un chiffre clé et son libellé.
// La valeur passe en ambre pour les espèces menacées (`accent`).
interface Props {
  valeur: string;
  libelle: string;
  accent?: boolean;
  class?: string;
}

const { valeur, libelle, accent = false, class: classe } = Astro.props;
---

<div class:list={["statistique", classe]}>
  <p class:list={["valeur", "t-titre-section-compact", { "valeur--accent": accent }]}>{valeur}</p>
  <p class="libelle">{libelle}</p>
</div>

<style>
  .statistique {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow-wrap: anywhere;
  }
  .statistique p {
    margin: 0;
  }
  .valeur--accent {
    color: var(--color-text-accent);
  }
  .libelle {
    font: 400 11px / 1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
</style>
