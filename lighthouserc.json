{
  "ci": {
    "collect": {
      "startServerCommand": "npx wrangler dev --ip 127.0.0.1 --port 8789",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:8789/fr",
        "http://127.0.0.1:8789/en",
        "http://127.0.0.1:8789/fr/espece/quercus-robur",
        "http://127.0.0.1:8789/fr/continent/europe",
        "http://127.0.0.1:8789/fr/pays/suisse",
        "http://127.0.0.1:8789/fr/groupe/oiseaux?lieu=CH",
        "http://127.0.0.1:8789/fr/recherche?q=chene"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "disableFullPageScreenshot": true
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(espece|species|recherche|search)).*$",
          "assertions": {
